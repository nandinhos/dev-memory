<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suite de testes contra o servico de banco definido em .github/workflows.

  Conexao em modo trust: nenhuma credencial eh embutida neste arquivo
  (qualquer ocorrencia do termo de credencial seria flagada pelo
  GitGuardian). Em CI, o servico de banco sobe com a variavel de
  ambiente de autenticacao configurada em modo trust. Localmente,
  ajuste o HBA do seu servico ou defina a variavel de ambiente adequada
  no shell antes de invocar o phpunit.

  O bootstrap tests/bootstrap.php valida a topologia ANTES de o Laravel
  carregar .env e aborta se DB_DATABASE não for dev_memory_test (postgres)
  ou :memory: (sqlite). Impede acidentes como o incidente 2026-08-02.

  Uso local:
      ./vendor/bin/phpunit -c phpunit.pgsql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="dev_memory_test" force="true"/>
        <env name="DB_USERNAME" value="ci_user" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
    </php>
</phpunit>
